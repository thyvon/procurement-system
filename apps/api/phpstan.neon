includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes
        # - Modules   # uncomment when the first module is scaffolded (nwidart/laravel-modules)
    level: 6
    # `app/` reaches into module models (e.g. UserResource -> EmployeeProfile),
    # so larastan must see module schemas too — it otherwise infers columns only
    # from database/migrations. Setting this replaces larastan's default path,
    # hence both entries.
    databaseMigrationsPath:
        - database/migrations
        - Modules/*/Database/Migrations
