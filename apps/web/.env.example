# Runtime API origin used by the app (and baked into the bundle as
# process.env.NEXT_PUBLIC_API_URL by the generated client). Dev reads
# .env.local; the Docker image gets it as a build arg.
# Do not include /api here; the app appends /api automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: OpenAPI spec source for `pnpm generate-client`
# (defaults to http://localhost:8000 — your local API).
# ORVAL_SPEC_URL=http://localhost:8000
