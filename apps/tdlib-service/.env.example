# --- TDLib service configuration -------------------------------------------
# Mode is chosen automatically: real when TG_API_ID + TG_API_HASH are set,
# mock otherwise (dev + node:test).

# HTTP
PORT=3080
# Tenant account this pod serves (telegram_accounts.id, ULID)
ACCOUNT_ID=
# Bearer token Laravel must send — MUST equal apps/api .env TELEGRAM_SERVICE_TOKEN
SERVICE_TOKEN=

# Laravel inbound webhook (signed)
LARAVEL_WEBHOOK_URL=http://host.docker.internal:8000/api/internal/telegram/inbound
WEBHOOK_HMAC_SECRET=                 # MUST equal apps/api .env TELEGRAM_WEBHOOK_SECRET
WEBHOOK_RETRIES=3

# Telegram credentials (from https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Full phone in international format, e.g. +85512345678
TG_PHONE=
# Database encryption key (TDLib secret, arbitrary for a new session)
TG_DB_KEY=change-me
# Persistent session storage (mount as a volume in Docker/Kubernetes)
TG_SESSION_DIR=./session
